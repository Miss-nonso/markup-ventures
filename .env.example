POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
# Local demo only. Production: APP_ENV=production, DEMO_LOGIN_ENABLED=false.
APP_ENV=development
DEMO_LOGIN_ENABLED=true
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
# Used when demo login is disabled. Tenant must already exist in PostgreSQL.
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_TENANT_ID=11111111-1111-4111-8111-111111111111

# Optional human role for the single configured account.
AUTH_ROLE=FleetOperator
# Optional JSON array of {email,password_hash,tenant_id,role}; overrides single account.
# Use single quotes around JSON in .env to preserve dollar signs in password hashes.
AUTH_USERS_JSON=
